# Copy this file to .env and fill in the keys you plan to use.
# Only one provider is required, but you can keep both for easy switching.

# Preferred provider: "openai" or "gemini"
LLM_PROVIDER=openai

# OpenAI configuration
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4.1-mini

# Google Gemini configuration
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3-flash-preview


# Session eviction configuration (optional)
METAMO_SESSION_MAX_ENTRIES=1000      # Maximum concurrent in-memory sessions (LRU cap)
METAMO_SESSION_TTL_SECONDS=86400     # Session expiration in seconds (86400 = 24 hours)
